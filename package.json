{
  "name": "tdarr-flow-test",
  "version": "0.1.0",
  "description": "A typed test harness for Tdarr flows: graph linting, plugin unit testing, and flow simulation.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdgluck/tdarr-flow-test.git"
  },
  "homepage": "https://github.com/sdgluck/tdarr-flow-test#readme",
  "bugs": "https://github.com/sdgluck/tdarr-flow-test/issues",
  "exports": {
    ".": "./src/index.ts",
    "./probe": "./src/probe.ts",
    "./types": "./src/types/index.ts",
    "./cli": "./src/cli.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "vendor",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "hooks:install": "husky",
    "plugins:update": "node scripts/update-plugins.ts",
    "plugins:check": "node scripts/check-plugins.ts"
  },
  "keywords": [
    "tdarr",
    "flow",
    "testing",
    "ffmpeg"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "bin": {
    "tdarr-test": "./src/cli.ts"
  }
}
